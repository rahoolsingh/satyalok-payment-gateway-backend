# General Config
FRONTEND_URL
QUIZCHAMP_URL

# SMTP Configuration
SMTP_HOST
SMTP_PORT
SMTP_EMAIL
SMTP_PASSWORD

# MongoDB Config
MONGO_URI
MONGO_DB_NAME

# PhonePe Config
PROD_URL
SALT_KEY
MERCHANT_ID
BACKEND_URL

# Quiz Champ 2026 server-to-server integration
QCB_API_KEY
QCB_CALLBACK_URL

# ─── Razorpay (one-time donations + preferred auto-debit rail) ───────────────
# Keys: Razorpay Dashboard → Account & Settings → API Keys.
# Webhook: https://<api-host>/webhook/razorpay with the secret below.
RAZORPAY_ENABLED=true
RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET

# ─── PhonePe Autopay (optional fallback if Razorpay is not configured) ───────
# PhonePe Autopay v2 uses OAuth client credentials (separate from SALT_KEY).
PHONEPE_AUTOPAY_ENABLED=false
PHONEPE_AUTOPAY_ENV=SANDBOX              # SANDBOX | PRODUCTION
PHONEPE_AUTOPAY_CLIENT_ID
PHONEPE_AUTOPAY_CLIENT_SECRET
PHONEPE_AUTOPAY_CLIENT_VERSION=1
PHONEPE_AUTOPAY_SETUP_MODE=UPI_COLLECT   # UPI_COLLECT (web) | UPI_INTENT (mobile)

# Webhook credentials configured on the PhonePe dashboard (sha256(user:pass))
PHONEPE_AUTOPAY_WEBHOOK_USERNAME
PHONEPE_AUTOPAY_WEBHOOK_PASSWORD

# Donor portal + data protection (generate with: openssl rand -base64 48)
PLEDGE_ENCRYPTION_KEY=                   # AES-256-GCM key for PAN at rest
PLEDGE_HASH_PEPPER=                      # HMAC pepper for donor lookup keys
PLEDGE_PORTAL_SECRET=                    # signs donor self-service magic links

# Programme limits (optional overrides)
PLEDGE_MIN_AMOUNT=100
PLEDGE_MAX_AMOUNT=10000
PLEDGE_VALIDITY_YEARS=5
PLEDGE_NOTIFY_LEAD_HOURS=26
PLEDGE_CONSENT_VERSION=2026-11-v1
PLEDGE_GRIEVANCE_EMAIL=support@satyalok.in
PLEDGE_TERMS_URL=https://donate.satyalok.in/terms
PLEDGE_PRIVACY_URL=https://donate.satyalok.in/privacy
PLEDGE_CRON_ENABLED=true

# SMTP timeouts so a dead mail host cannot stall the debit engine
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
